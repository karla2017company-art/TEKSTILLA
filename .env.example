# ILYA | إيليا - Environment Configuration
PORT=3000
NODE_ENV=production
JWT_SECRET=replace_with_strong_random_jwt_secret_key_64_chars
DATABASE_PATH=./backend/ilya_store.sqlite

# Turkish Payment Gateway: iyzico (https://dev.iyzipay.com)
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# Turkish Payment Gateway: PayTR (https://www.paytr.com)
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=

# SMTP Email Configuration (for Order Receipts & Price Drop Alerts)
SMTP_HOST=smtp.yourdomain.com
SMTP_PORT=587
SMTP_USER=notifications@ilya-fashion.com.tr
SMTP_PASS=
SMTP_FROM="ILYA Fashion | إيليا للأزياء <notifications@ilya-fashion.com.tr>"

# Web Push VAPID Keys (for Future Browser Push Notifications)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Trendyol Partner Marketplace API (https://developers.trendyol.com/)
TRENDYOL_SUPPLIER_ID=894512
TRENDYOL_API_KEY=your_trendyol_api_key
TRENDYOL_API_SECRET=your_trendyol_api_secret
TRENDYOL_COMMISSION_PCT=18

# Hepsiburada Merchant MPOP API (https://developers.hepsiburada.com/)
HEPSIBURADA_MERCHANT_ID=your_hepsiburada_merchant_id
HEPSIBURADA_API_USERNAME=your_hepsiburada_username
HEPSIBURADA_API_SECRET=your_hepsiburada_service_key
HEPSIBURADA_COMMISSION_PCT=17
